# Скопируйте в .env и подставьте свои значения. Файл .env не коммитится.

# Профиль: dev | test | prod. Без переменной процесс считается боевым (prod) и требует
# JWT_SECRET, COOKIE_SECURE=true и SMTP — забытая настройка не открывает /dev/outbox с кодами.
APP_ENV=dev
HTTP_ADDR=127.0.0.1:8080

# PostgreSQL (локально: роль fsp_platform, базы fsp_platform и fsp_platform_test)
DATABASE_URL=postgres://fsp_platform:CHANGE_ME@localhost:5432/fsp_platform?sslmode=disable
TEST_DATABASE_URL=postgres://fsp_platform:CHANGE_ME@localhost:5432/fsp_platform_test?sslmode=disable
MIGRATE_ON_START=true

LOG_LEVEL=debug
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=10s

# Аутентификация
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_PLUS_CHARS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=336h
COOKIE_SECURE=false
BASE_URL=http://127.0.0.1:8080
CONSENT_VERSION=2026-10-01
# Почта: console — письма в лог и /api/v1/dev/outbox (только dev); smtp — на стенде
MAIL_PROVIDER=console
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=587          # 587 — STARTTLS, 465 — TLS; без TLS учётные данные не отправляются
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=ФСП <noreply@example.ru>
# CORS для dev-сервера фронтенда (через запятую); пусто — выключено
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=600
# Обратные прокси (Caddy), которым доверяется X-Forwarded-For: адреса или CIDR через запятую.
# Пусто — заголовок игнорируется, клиент определяется по TCP-соединению.
TRUSTED_PROXIES=
# Токен для /metrics (Authorization: Bearer ...). Вне dev без токена /metrics не публикуется.
METRICS_TOKEN=

# ФСП ID (OpenID Connect). Локально — эмулятор `task fspmock` на :8090; в будущем — Keycloak ФСП.
# Пустой FSP_OIDC_ISSUER выключает вход через ФСП ID.
FSP_OIDC_ISSUER=http://127.0.0.1:8090/realms/fsp
FSP_OIDC_CLIENT_ID=fsp-platform
FSP_OIDC_CLIENT_SECRET=fsp-platform-secret
# FSP_OIDC_REDIRECT_URL=http://127.0.0.1:8080/api/v1/auth/fsp/callback
FSP_REGISTRY_URL=http://127.0.0.1:8090
# Адрес SPA для возврата после входа через ФСП ID (dev — Vite)
FRONTEND_URL=http://localhost:5173

# LLM: в MVP используется детерминированный эмулятор (mock).
# Другие значения (openai, gigachat, ollama) включаются позже, по отдельному решению.
LLM_PROVIDER=mock

# Каталог собранного фронтенда (web/dist). Пусто — автоопределение, "-" — не раздавать.
WEB_DIR=

# Пользователи с этими e-mail получают роль admin при старте API (через запятую)
ADMIN_EMAILS=
